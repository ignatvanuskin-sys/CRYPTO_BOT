# Secrets are intentionally blank in this template.
BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/paperdemo
REQUIRE_POSTGRES=true
ADMIN_TELEGRAM_IDS=

INITIAL_BALANCE_USD=10000
